---
// Everything in <head> that describes the page to search engines and share cards:
// title, description, canonical, hreflang, Open Graph, Twitter, icons, sitemap, JSON-LD.
// Titles and descriptions come from the data files (data/<lang>.ts, data/cv/<lang>.ts).
// The 404 page is the one page that is not indexed and has no canonical or alternates.
import { getContent } from '../data';
import { getShell } from '../data/shell';
import { DEFAULT_LANG, SITE_URL, ogImage, person, type CaseSlug, type Lang } from '../data/site';
import { alternates, href, type PageKind } from '../i18n/routes';

interface Props {
  lang: Lang;
  kind: PageKind;
  slug?: CaseSlug;
  title: string;
  description: string;
}
const { lang, kind, slug, title, description } = Astro.props;
const t = getContent(lang);
const site = Astro.site ?? new URL(SITE_URL);
const abs = (path: string) => new URL(path, site).href;

const indexable = kind !== '404';
const url = abs(href(lang, kind, slug));
const alts = alternates(kind, slug);
const og = ogImage(lang);
const image = abs(og.src);
const others = alts.filter((a) => a.lang !== lang);

const root = abs('/');
const personId = `${root}#person`;
const siteId = `${root}#website`;
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: person.name,
      url: root,
      email: `mailto:${person.email}`,
      jobTitle: getShell(lang).person.jobTitle,
      description: t.person.line,
      address: { '@type': 'PostalAddress', addressLocality: 'Toulouse', addressCountry: 'FR' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: getShell(lang).person.school },
      sameAs: [person.github, person.linkedin],
      knowsAbout: getShell(lang).person.knowsAbout,
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: root,
      name: person.name,
      inLanguage: alts.map((a) => getContent(a.lang).locale),
      author: { '@id': personId },
    },
    {
      '@type': kind === 'home' || kind === 'cv' ? 'ProfilePage' : 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      inLanguage: t.locale,
      isPartOf: { '@id': siteId },
      mainEntity: kind === 'home' || kind === 'cv' ? { '@id': personId } : undefined,
      about: { '@id': personId },
      primaryImageOfPage: { '@type': 'ImageObject', url: image, width: og.w, height: og.h },
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={person.name} />
{indexable ? <link rel="canonical" href={url} /> : <meta name="robots" content="noindex" />}
{alts.length > 1 && alts.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
{alts.length > 1 && <link rel="alternate" hreflang="x-default" href={abs(href(DEFAULT_LANG, kind, slug))} />}
<meta name="theme-color" content="#1632D4" />

<meta property="og:type" content={kind === 'work' ? 'article' : 'website'} />
<meta property="og:site_name" content={person.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{indexable && <meta property="og:url" content={url} />}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(og.w)} />
<meta property="og:image:height" content={String(og.h)} />
<meta property="og:image:alt" content={t.meta.ogAlt} />
<meta property="og:locale" content={t.locale.replace('-', '_')} />
{others.map((a) => <meta property="og:locale:alternate" content={getContent(a.lang).locale.replace('-', '_')} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={t.meta.ogAlt} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
{indexable && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
